  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  admin_users admin_users? @relation(fields: [invited_by], references: [id], onUpdate: NoAction)
  stores      stores?      @relation(fields: [store_id], references: [id], onUpdate: NoAction)

  @@index([invited_by])
  @@index([expires_at], map: "staff_invites_pending_idx", where: raw("((accepted_at IS NULL) AND (revoked_at IS NULL))"))
  @@schema("public")
}

