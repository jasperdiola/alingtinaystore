  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  store_id           String?          @db.Uuid
  admin_users        admin_users?     @relation(fields: [changed_by], references: [id], onUpdate: NoAction)
  products           products?        @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  product_sizes      product_sizes?   @relation(fields: [product_size_id], references: [id], onUpdate: NoAction)
  stores             stores?          @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  store_inventory    store_inventory? @relation(fields: [store_inventory_id], references: [id], onUpdate: NoAction)

  @@index([product_id, created_at(sort: Desc)], map: "price_history_product_idx")
  @@index([created_at(sort: Desc)], map: "price_history_recent_idx")
  @@index([store_id, created_at(sort: Desc)], map: "price_history_store_idx")
  @@schema("public")
}

