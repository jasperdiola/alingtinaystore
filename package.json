{
  "name": "aling-tinay-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next build && next start -p 4000",
    "lint": "eslint",
    "verify:db": "tsx scripts/verify-all.ts",
    "check:render": "next build && node --import tsx --conditions=react-server scripts/render-check.ts",
    "check:render:prebuilt": "node --import tsx --conditions=react-server scripts/render-check.ts",
    "ci:secrets": "tsx scripts/ci-secrets.ts",
    "db:pull": "prisma db pull && prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:crud-test": "tsx scripts/crud-test.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:purge-demo": "tsx scripts/purge-demo.ts",
    "db:analytics-check": "node --import tsx --conditions=react-server scripts/analytics-check.ts",
    "db:orders-check": "node --import tsx --conditions=react-server scripts/orders-check.ts",
    "db:inventory-check": "node --import tsx --conditions=react-server scripts/inventory-check.ts",
    "db:pricing-check": "node --import tsx --conditions=react-server scripts/pricing-check.ts",
    "db:pos-check": "node --import tsx --conditions=react-server scripts/pos-check.ts",
    "db:staff-check": "node --import tsx --conditions=react-server scripts/staff-check.ts",
    "db:catalog-check": "node --import tsx --conditions=react-server scripts/catalog-check.ts",
    "db:stock-check": "node --import tsx --conditions=react-server scripts/stock-integrity-check.ts",
    "db:price-check": "node --import tsx --conditions=react-server scripts/price-history-check.ts",
    "db:void-check": "node --import tsx --conditions=react-server scripts/void-check.ts",
    "db:image-check": "node --import tsx --conditions=react-server scripts/image-check.ts",
    "db:checkout-check": "node --import tsx --conditions=react-server scripts/checkout-check.ts",
    "db:shop-check": "node --import tsx --conditions=react-server scripts/shop-check.ts",
    "db:set-qr": "node --import tsx --conditions=react-server scripts/set-payment-qr.ts",
    "vercel:env": "tsx scripts/vercel-env.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
