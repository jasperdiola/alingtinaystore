# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this template is committed so the required keys are
# documented for CI and for anyone setting the project up fresh.
#
# Find PROJECT-REF and REGION in the Supabase dashboard under "Connect".
# The pooler requires the username to be `prisma.<PROJECT-REF>`, not just `prisma`.
# URL-encode the password if it contains special characters.

# Runtime connection used by Prisma Client (lib/prisma.ts).
# Transaction pooler, port 6543. `pgbouncer=true` disables prepared statements,
# which the transaction pooler cannot support.
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection used by the Prisma CLI (db pull, generate, migrate, studio).
# Session pooler, port 5432. Schema operations need a real session.
DIRECT_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth, used by @supabase/ssr for the admin login.
# Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_OR_PUBLISHABLE_KEY]"

# Required to create an admin at /admin/signup. Unset it to close sign-up.
ADMIN_SIGNUP_CODE="[LONG_RANDOM_STRING]"

# Signs the admin idle-timeout cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every admin out immediately.
SESSION_SECRET="[LONG_RANDOM_STRING]"

# Only needed in production to allow catalog writes before real auth is wired.
# ADMIN_WRITES_ENABLED="true"

# Admin credentials for `npm run check:render` (renders the admin site).
RENDER_CHECK_EMAIL=
RENDER_CHECK_PASSWORD=

# --- CI / deployment (GitHub Actions -> Vercel) --------------------------
# Not used by the app; consumed by .github/workflows/ci.yml.
# Run `npm run ci:secrets` to list every GitHub Actions secret to create.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
